{
  "schemaVersion": 1,
  "id": "pride_land",
  "version": "${version}",
  "name": "Pride Land",
  "description": "A mod that adds pride-themed blocks, items, and entities to Minecraft.",
  "authors": [
    "Wolren",
    "PrideLand Team"
  ],
  "contact": {
    "homepage": "https://www.prideland.net/",
    "sources": "https://github.com/wolren/PrideLand"
  },
  "license": "MIT",
  "icon": "assets/pride_land/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.wolren.land.quilt.LandQuilt"
    ],
    "client": [
      "net.wolren.land.quilt.LandQuiltClient"
    ],
    "modmenu": [
      "net.wolren.land.integration.menu.ModMenuEntry"
    ]
  },
  "mixins": [
    "pride_land.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20.1",
    "fabric-api": "*",
    "architectury": ">=9.0.0",
    "cloth-config": ">=11.0.0"
  },
  "custom": {
    "mcb": [
      {
        "name": "Client & Server",
        "fillColor": -1761620992,
        "outlineColor": -929470976
      },
      {
        "name": "Gay Certified",
        "fillColor": -924581117,
        "outlineColor": -931976830
      }
    ],
    "modmenu": {
      "update_checker": true
    }
  }
}
